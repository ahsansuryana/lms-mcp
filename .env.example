# --- Kredensial LMS (akun mahasiswa sendiri) ---
# LMS_USERNAME = NIM (atau username yang dipakai di halaman login lms.uinsgd.ac.id)
LMS_USERNAME=
LMS_PASSWORD=

# --- Opsional ---
LMS_BASE_URL=https://api.uinsgd.ac.id/lms
LMS_ORIGIN=https://lms.uinsgd.ac.id

# Transport: stdio (default, untuk Claude Desktop/Cursor) atau http
MCP_TRANSPORT=stdio

# Hanya jika MCP_TRANSPORT=http (bind 127.0.0.1, path /mcp, wajib Bearer token)
MCP_HTTP_PORT=3333
MCP_AUTH_TOKEN=
